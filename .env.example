# CineMax backend configuration
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Optional TMDB integration (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional OMDb integration (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Seed admin account (created on first run)
ADMIN_EMAIL=admin@cinemax.app
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123
